<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MotoTripTracker"
        android:name=".MotoTripApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MotoTripTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tracking.service.TrackingForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          DET-001/ADR-007: the PendingIntent target for Activity Recognition
          Transition updates. Not exported - Play Services invokes it via
          the PendingIntent our own process created and handed over, which
          works regardless of this component's exported flag (the same
          mechanism notification action buttons use), not via an arbitrary
          external Intent send.
        -->
        <receiver
            android:name=".tracking.receiver.ActivityTransitionReceiver"
            android:exported="false" />

        <!--
          DET-001/F0.4 §4.5 (AND-007): re-registers Activity Recognition
          after reboot/app-update, since Google documents that registration
          doesn't survive either. Exported=true is the standard, broadly
          accepted pattern for a BOOT_COMPLETED receiver (a system-sent
          broadcast); onReceive() itself still checks the action.
        -->
        <receiver
            android:name=".tracking.receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          TRK-004: WorkManager's default on-demand initializer runs as a
          ContentProvider, which is created before Application.onCreate() -
          before Hilt has injected HiltWorkerFactory into MotoTripApplication.
          Verified on-device: the default initializer silently used a plain
          Configuration (no custom worker factory), so @HiltWorker classes
          like TripProcessingWorker failed with
          "NoSuchMethodException: ...<init>[Context, WorkerParameters]" -
          WorkManager's reflection-based default factory can't build a class
          with extra Hilt-injected constructor parameters. Disabling this and
          calling WorkManager.initialize() manually from onCreate() (after
          injection has happened) is the documented fix for this exact
          Hilt/WorkManager ordering problem.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>

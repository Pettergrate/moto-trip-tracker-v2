<?xml version="1.0" encoding="utf-8"?>
<!--
    PRV-001 / privacy-permissions.md 12.2: the same rules for Android 11 and below (`android:fullBackupContent`), where
    `data_extraction_rules.xml` does not apply. Nothing is backed up.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
